/**
 * Wrangler configuration for the subdomain-index Worker.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-19",
	// Node.js compatibility is required by the MCP server runtime.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public"
	},
	// Required by Workers Builds preview deploys (wrangler preview).
	"previews": {}
}
